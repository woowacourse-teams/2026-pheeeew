logging {
	level = "warn"
}

prometheus.scrape "app" {
	targets = [{
		__address__ = "app:8080",
		application = "pheeeew",
		environment = "prod",
		instance    = "pheeeew-prod",
	}]
	job_name        = "pheeeew-api"
	honor_labels    = true
	metrics_path    = "/actuator/prometheus"
	scrape_interval = "60s"
	scrape_timeout  = "10s"
	forward_to      = [prometheus.relabel.app.receiver]
}

prometheus.relabel "app" {
	forward_to = [prometheus.remote_write.grafana.receiver]

	// pheeeew_group_press_* 는 일부러 넣지 않는다. ADR-0032 의 전환이 끝나면 사라지는 경로다.
	rule {
		source_labels = ["__name__"]
		regex         = "up|scrape_duration_seconds|scrape_samples_scraped|http_server_requests_seconds_(count|sum|bucket|max)|pheeeew_app_version_checks_total|pheeeew_sigh_list_(query_seconds_(count|sum|bucket|max)|results_(count|sum|max))|pheeeew_activity_(dau|mau|last_aggregated_seconds|collection_started_seconds|record_failures_total|aggregation_failures_total)|jvm_memory_(used|committed|max)_bytes|jvm_gc_pause_seconds_(count|sum|max)|jvm_threads_live_threads|tomcat_threads_(busy|current|config_max)_threads|process_(cpu_usage|uptime_seconds)|system_cpu_usage|hikaricp_connections(_(active|idle|pending|max|min|timeout_total|(acquire|usage)_seconds_(count|sum|max)))?|spring_data_repository_invocations_seconds_(count|sum|bucket|max)|pheeeew_emotion_create_throttled_total|pheeeew_device_attestation_(accepted|skipped|verdict|rejected)_total|pheeeew_device_appattest_(accepted|rejected)_total|pheeeew_emotion_press_((empty|deadlocks)_total|(applied|clamped|states)_(count|sum|max)|query_seconds_(count|sum|bucket|max))|pheeeew_region_query_seconds_(count|sum|bucket|max)"
		action        = "keep"
	}
}

prometheus.remote_write "grafana" {
	endpoint {
		url              = sys.env("GRAFANA_METRICS_URL")
		follow_redirects = false

		basic_auth {
			username = sys.env("GRAFANA_METRICS_USER")
			password = sys.env("GRAFANA_CLOUD_TOKEN")
		}

		queue_config {
			min_shards           = 1
			max_shards           = 2
			capacity             = 2500
			max_samples_per_send = 500
		}
	}

	wal {
		truncate_frequency = "15m"
		min_keepalive_time = "5m"
		max_keepalive_time = "1h"
	}
}

// Read only the active file. Archives are retained locally, not re-ingested.
loki.source.file "app" {
	targets = [{
		__path__    = "/var/log/pheeeew/application.json",
		job         = "pheeeew-api",
		application = "pheeeew",
		environment = "prod",
		instance    = "pheeeew-prod",
	}]
	forward_to = [loki.process.http_requests.receiver]
}

loki.process "http_requests" {
	forward_to = [loki.write.grafana.receiver]

	stage.json {
		expressions = {
			logger    = "logger_name",
			event     = "event",
			level     = "level",
			timestamp = "\"@timestamp\"",
		}
		drop_malformed = true
	}

	stage.labels {
		values = {logger = "", event = "", level = ""}
	}
	// 개인정보 검토를 마친 클래스와 해당 이벤트의 조합만 전송한다.
	stage.match {
		selector            = "{job=\"pheeeew-api\", logger!~\"com[.]pheeeew[.](common[.]logging[.](RequestLogWriter|ScheduledTaskErrorHandler)|activity[.]infra[.](DeviceActivityRecorder|DeviceActivityAggregationScheduler))\"}"
		action              = "drop"
		drop_counter_reason = "unreviewed_logger"
	}

	stage.match {
		selector            = "{job=\"pheeeew-api\", logger=\"com.pheeeew.common.logging.RequestLogWriter\", event!~\"http_request_failed|http_request_slow\"}"
		action              = "drop"
		drop_counter_reason = "unreviewed_event"
	}

	stage.match {
		selector            = "{job=\"pheeeew-api\", logger=\"com.pheeeew.activity.infra.DeviceActivityRecorder\", event!=\"device_activity_record_failed\"}"
		action              = "drop"
		drop_counter_reason = "unreviewed_event"
	}

	stage.match {
		selector            = "{job=\"pheeeew-api\", logger=\"com.pheeeew.activity.infra.DeviceActivityAggregationScheduler\", event!=\"device_activity_aggregation_failed\"}"
		action              = "drop"
		drop_counter_reason = "unreviewed_event"
	}

	stage.match {
		selector            = "{job=\"pheeeew-api\", logger=\"com.pheeeew.common.logging.ScheduledTaskErrorHandler\", event!=\"scheduled_task_failed\"}"
		action              = "drop"
		drop_counter_reason = "unreviewed_event"
	}

	stage.match {
		selector            = "{job=\"pheeeew-api\", logger=~\"com[.]pheeeew[.](common[.]logging[.]ScheduledTaskErrorHandler|activity[.]infra[.](DeviceActivityRecorder|DeviceActivityAggregationScheduler))\", level!=\"ERROR\"}"
		action              = "drop"
		drop_counter_reason = "unreviewed_level"
	}

	stage.timestamp {
		source            = "timestamp"
		format            = "RFC3339Nano"
		action_on_failure = "skip"
	}

	stage.label_drop {
		values = ["logger", "filename"]
	}
}

// 독립 수집기의 시간별 표본. 보관된 파일도 처음부터 읽고 storage.path의 위치를 재사용한다.
loki.source.file "db_observer" {
    targets = [{
        __path__    = "/var/log/db-observer/sample-*.jsonl",
        job         = "pheeeew-db-observer",
        application = "pheeeew",
        environment = "prod",
        instance    = "pheeeew-prod",
    }]
    tail_from_end = false
    file_match {
        enabled = true
        sync_period = "10s"
    }
    forward_to = [loki.process.db_observer.receiver]
}

loki.process "db_observer" {
    forward_to = [loki.write.grafana.receiver]
    stage.json {
        expressions = {
            event = "event",
            schema = "schema_version == `1`",
            status = "status",
            reason = "reason",
            timestamp = "status == 'ok' && snapshot.sampled_at || status == 'error' && collected_at",
            safe = "to_string({event:event,schema_version:schema_version,collected_at:collected_at,status:status,reason:status == 'error' && reason || `null`,snapshot:status == 'ok' && {sampled_at:snapshot.sampled_at,visibility:snapshot.visibility,read_all_stats:snapshot.read_all_stats,session_count:snapshot.session_count,unknown_state_count:snapshot.unknown_state_count,disabled_count:snapshot.disabled_count,eligible_count:snapshot.eligible_count,omitted_count:snapshot.omitted_count,active_count:snapshot.active_count,idle_in_transaction_count:snapshot.idle_in_transaction_count,lock_wait_count:snapshot.lock_wait_count,io_wait_count:snapshot.io_wait_count,other_wait_count:snapshot.other_wait_count,no_wait_count:snapshot.no_wait_count,sessions:snapshot.sessions[].{pid:pid,backend_start:backend_start,backend_type:backend_type,state:state,wait_event_type:wait_event_type,wait_event:wait_event,query_elapsed_ms:query_elapsed_ms,transaction_elapsed_ms:transaction_elapsed_ms,state_elapsed_ms:state_elapsed_ms,blocker_pids:blocker_pids,blocker_count:blocker_count}} || `null`})",
        }
        drop_malformed = true
    }
    stage.labels {
        values = {event = "", schema = "", status = "", reason = "", timestamp = ""}
    }
    stage.match {
        selector = "{job=\"pheeeew-db-observer\", event!=\"db_activity_snapshot\"}"
        action = "drop"
        drop_counter_reason = "observer_event"
    }
    stage.match {
        selector = "{job=\"pheeeew-db-observer\", schema!=\"true\"}"
        action = "drop"
        drop_counter_reason = "observer_schema"
    }
    stage.match {
        selector = "{job=\"pheeeew-db-observer\", status!~\"ok|error\"}"
        action = "drop"
        drop_counter_reason = "observer_status"
    }
    stage.match {
        selector = "{job=\"pheeeew-db-observer\", status=\"error\", reason!~\"client_unavailable|process_timeout|output_limit|psql_failed|invalid_snapshot|client_io_failed|collector_stopped|configuration_missing\"}"
        action = "drop"
        drop_counter_reason = "observer_reason"
    }
    stage.match {
        selector = "{job=\"pheeeew-db-observer\", timestamp!~\"([0-9]{4}-((01|03|05|07|08|10|12)-(0[1-9]|[12][0-9]|3[01])|(04|06|09|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))|([0-9]{2}(0[48]|[2468][048]|[13579][26])|([02468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])\"}"
        action = "drop"
        drop_counter_reason = "observer_timestamp"
    }
    stage.timestamp {
        source = "timestamp"
        format = "RFC3339Nano"
        action_on_failure = "skip"
    }
    // 허용한 키만 새 JSON으로 만든다. 원본 SQL/자격 증명 등 추가 키는 중첩 객체에서도 버린다.
    stage.output {
        source = "safe"
    }
    stage.label_keep {
        values = ["job", "application", "environment", "instance"]
    }
}

loki.write "grafana" {
	endpoint {
		url              = sys.env("GRAFANA_LOGS_URL")
		follow_redirects = false

		basic_auth {
			username = sys.env("GRAFANA_LOGS_USER")
			password = sys.env("GRAFANA_CLOUD_TOKEN")
		}
	}
}
