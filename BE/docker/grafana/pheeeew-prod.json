        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"pheeeew-api\",environment=\"prod\",instance=\"pheeeew-prod\",area=\"heap\"}) / sum(jvm_memory_max_bytes{job=\"pheeeew-api\",environment=\"prod\",instance=\"pheeeew-prod\",area=\"heap\"} > 0)",
          "legendFormat": "힙 사용 비율",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "interval": "1m"
