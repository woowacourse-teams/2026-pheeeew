{
  "id": null,
  "uid": "pheeeew-prod-overview",
  "title": "Pheeeew 운영 모니터링",
  "description": "운영 EC2 한 대의 앱 지표와 검토된 HTTP 로그. 수집 주기 60초. EC2 전체·RDS 내부·Cloudflare 외부 가용성은 별도 확인.",
  "tags": [
    "pheeeew",
    "production"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "앱 지표 수집 상태",
      "description": "1은 마지막 수집 성공, 0은 실패. 데이터 없음은 아직 연결되지 않았거나 수집·전송이 멈춘 상태일 수 있어요. 외부 URL 가용성 검사가 아니에요.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "데이터 없음",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "수집 실패",
                  "color": "red"
                },
                "1": {
                  "text": "수집 성공",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{job=\"pheeeew-api\",environment=\"prod\",instance=\"pheeeew-prod\"})",
          "legendFormat": "수집 상태",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "interval": "1m"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "전체 API 요청 / 초",
      "description": "앱까지 도달한 /api/ 요청만 포함해요. Actuator 수집 요청은 제외해요.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "데이터 없음",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"pheeeew-api\",environment=\"prod\",instance=\"pheeeew-prod\",uri=~\"/api/.*\"}[$__rate_interval]))",
          "legendFormat": "요청/초",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "interval": "1m"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "전체 API 5xx 비율",
      "description": "요청이 있고 5xx가 없으면 0%. 요청 자체가 없으면 계산할 수 없어 데이터 없음으로 표시해요.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "데이터 없음",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"pheeeew-api\",environment=\"prod\",instance=\"pheeeew-prod\",uri=~\"/api/.*\",status=~\"5..\"}[$__rate_interval])) or (0 * sum(rate(http_server_requests_seconds_count{job=\"pheeeew-api\",environment=\"prod\",instance=\"pheeeew-prod\",uri=~\"/api/.*\"}[$__rate_interval])))) / sum(rate(http_server_requests_seconds_count{job=\"pheeeew-api\",environment=\"prod\",instance=\"pheeeew-prod\",uri=~\"/api/.*\"}[$__rate_interval]))",
          "legendFormat": "5xx 비율",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "interval": "1m"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "JVM 힙 사용 비율",
      "description": "앱 JVM 힙 사용량 / 유효한 힙 최대 용량. EC2 전체 메모리 사용률이 아니에요.",
      "datasource": {
