+/** Measures virtual source-to-state timing, not network or rendered-frame latency. */
+@OptIn(ExperimentalCoroutinesApi::class)
+class ScreenLoadingProbeTest {
+    @Test
+    fun compareLoadingPaths() =
+        runTest {
+            Dispatchers.setMain(StandardTestDispatcher(testScheduler))
+            try {
+                for (latency in listOf(0L, 50L, 200L, 1500L)) {
+                    repeat(3) { repetition ->
+                        var calls = 0
+
+                        fun record(
+                            path: String,
+                            action: () -> Unit,
+                        ) {
+                            val start = testScheduler.currentTime
+                            val before = calls
+                            action()
+                            advanceUntilIdle()
+                            println(
+                                "LOADING_PROBE,$path,$latency,$repetition,${testScheduler.currentTime - start},${calls - before}",
+                            )
+                        }
+                        val stampSource =
+                            object : WeeklyRankingSource {
+                                override suspend fun load(weeksAgo: Int): WeeklyRankingLoadResult {
+                                    calls++
+                                    delay(latency)
+                                    return WeeklyRankingLoadResult.Loaded(
+                                        "2026-10-19T00:00:00Z",
+                                        "2026-10-26T00:00:00Z",
+                                        true,
+                                        emptyList(),
+                                    )
+                                }
+                            }
+                        lateinit var stamp: WeeklyRankingViewModel
+                        record("stamp_initial") { stamp = WeeklyRankingViewModel(stampSource) }
+                        assertEquals(WeeklyRankingStatus.Ready, stamp.uiState.value.status)
+                        record("stamp_refresh") { stamp.onRefresh() }
+                        record("stamp_previous") { stamp.onPreviousWeek() }
+                        val pressSource =
+                            object : PressRankingSource {
+                                override suspend fun load(
+                                    emotion: PressEmotion,
+                                    weeksAgo: Int,
+                                ): PressRankingLoadResult {
+                                    calls++
+                                    delay(latency)
+                                    return PressRankingLoadResult.Loaded(
+                                        "2026-10-19T00:00:00Z",
+                                        "2026-10-26T00:00:00Z",
+                                        true,
+                                        emptyList(),
+                                    )
+                                }
+                            }
+                        lateinit var press: PressRankingViewModel
+                        record("press_initial") { press = PressRankingViewModel(pressSource) }
+                        assertEquals(PressRankingStatus.Ready, press.uiState.value.status)
+                        record("press_refresh") { press.onRefresh() }
+                        record("press_filter") { press.onEmotionSelected(PressEmotion.Angry) }
+                        record("press_previous") { press.onPreviousWeek() }
+                        val groups =
+                            object : GroupListSource {
+                                override suspend fun loadGroups(): GroupListResult {
+                                    calls++
+                                    delay(latency)
+                                    return GroupListResult.Success(emptyList())
+                                }
+                            }
+                        lateinit var home: GroupHomeViewModel
+                        record("group_initial") {
+                            home =
+                                GroupHomeViewModel(
+                                    groupListSource = groups,
+                                    groupJoinDependencies =
+                                        GroupJoinDependencies(
+                                            lookupGroupAction = { GroupLookupResult.Unavailable },
+                                            joinGroupAction = { _, _ -> GroupJoinResult.Unavailable },
+                                            errorReporter = {},
+                                            operationKeyAllocator = GroupOperationKeyAllocator("loading-probe"),
+                                        ),
+                                    groupExploreSource = InMemoryGroupExploreSource(emptyList()),
+                                )
+                        }
+                        assertIs<GroupHomeContent.Empty>(home.uiState.value.content)
+                        record("group_refresh") { home.refresh() }
+                        record("group_clean_reentry") { home.refreshIfDirty() }
+                        record("group_dirty_reentry") {
+                            home.invalidateMembership()
+                            home.refreshIfDirty()
+                        }
+                    }
+                }
+            } finally {
+                Dispatchers.resetMain()
+            }
+        }
+}
